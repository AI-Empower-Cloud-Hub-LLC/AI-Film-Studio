# ============================================================================
# AI FILM STUDIO - FREE-ONLY ENVIRONMENT CONFIGURATION
# ============================================================================
# No paid API keys, no registration, no credit cards required.
# Uses Ollama (local LLM) and optionally Google Generative AI (free tier).
# ============================================================================

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=AI-Film-Studio
APP_ENV=development
SECRET_KEY=change-me-in-production

# ============================================================================
# LLM BACKEND — "ollama" (default, fully local) or "google" (free tier)
# ============================================================================
LLM_BACKEND=ollama

# Ollama (local LLM server — https://ollama.ai)
# Install: curl -fsSL https://ollama.ai/install.sh | sh
# Pull a model: ollama pull mistral
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Google Generative AI (FREE tier — https://ai.google.dev)
# Optional: get a free API key at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.0-flash

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=sqlite:///./ai_film_studio.db

# PostgreSQL (for Docker Compose)
# DATABASE_URL=postgresql://filmstudio:changeme@localhost:5432/ai_film_studio
POSTGRES_USER=filmstudio
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ai_film_studio

# ============================================================================
# REDIS (optional — for Celery task queue)
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# CORS
# ============================================================================
CORS_ORIGINS=http://localhost:3000

# ============================================================================
# FRONTEND
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
