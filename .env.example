# ===========================================
# AI Film Studio — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# docker-compose reads .env from the project root.

# --- Application ---
APP_ENV=development          # development | production
SECRET_KEY=                  # Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
DEBUG=true                   # Set to false in production

# --- Database ---
# SQLite (default for development):
# DATABASE_URL=sqlite:///./ai_film_studio.db
# PostgreSQL (recommended for production):
DATABASE_URL=postgresql://filmstudio:changeme@localhost:5432/ai_film_studio
POSTGRES_USER=filmstudio
POSTGRES_PASSWORD=changeme   # CHANGE in production
POSTGRES_DB=ai_film_studio

# --- AI Service API Keys ---
GOOGLE_API_KEY=              # Gemini API Key (get from https://ai.google.dev)
GOOGLE_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=           # Optional — Claude agent pipeline
OPENAI_API_KEY=              # Optional — GPT fallback
ELEVENLABS_API_KEY=          # Optional — voice synthesis
STABILITY_API_KEY=           # Optional — image generation
REPLICATE_API_TOKEN=         # Optional — video generation
RUNWAY_API_KEY=              # Optional — Runway AI video generation

# --- Ports (docker-compose) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- CORS ---
# Development:
CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]
# Production (set to your domain):
# CORS_ORIGINS=["https://your-domain.com"]

# --- Email (for verification & password reset) ---
SMTP_HOST=                   # e.g., smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                   # e.g., your-email@gmail.com
SMTP_PASSWORD=               # App-specific password
SMTP_FROM_EMAIL=noreply@aifilmstudio.com
SMTP_TLS=true
EMAIL_VERIFICATION_REQUIRED=false  # Set true to require email verification

# --- Error Monitoring ---
SENTRY_DSN=                  # Get from https://sentry.io — leave empty to disable

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60     # Max requests per minute per IP
