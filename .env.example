# ============================================================================
# AI FILM STUDIO - MULTI-BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# Default: Ollama (free, local). Optional: Google AI, Claude, ElevenLabs, Runway.
# ============================================================================

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=AI-Film-Studio
APP_ENV=development
SECRET_KEY=change-me-in-production

# ============================================================================
# LLM BACKEND — "ollama" (default, fully local) or "google" (free tier)
# ============================================================================
LLM_BACKEND=ollama

# Ollama (local LLM server — https://ollama.ai)
# Install: curl -fsSL https://ollama.ai/install.sh | sh
# Pull a model: ollama pull mistral
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Google Generative AI (FREE tier — https://ai.google.dev)
# Optional: get a free API key at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.0-flash

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=sqlite:///./ai_film_studio.db

# PostgreSQL (for Docker Compose)
# DATABASE_URL=postgresql://filmstudio:changeme@localhost:5432/ai_film_studio
POSTGRES_USER=filmstudio
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ai_film_studio

# ============================================================================
# REDIS (optional — for Celery task queue)
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# PREMIUM BACKENDS (optional)
# ============================================================================

# Anthropic Claude (premium LLM — https://console.anthropic.com)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ElevenLabs (premium voice — https://elevenlabs.io)
# VOICE_BACKEND=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Runway (video generation — https://docs.dev.runwayml.com)
# RUNWAY_API_KEY=

# ============================================================================
# MONGODB (optional — for pipeline history persistence)
# ============================================================================
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB_NAME=ai_film_studio

# ============================================================================
# CORS
# ============================================================================
CORS_ORIGINS=http://localhost:3000

# ============================================================================
# FRONTEND
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
