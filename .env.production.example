# ===========================================
# AI Film Studio — Production Environment
# ===========================================

# Application Settings
APP_NAME=AI-Film-Studio
APP_ENV=production
DEBUG=False
API_VERSION=v1
SECRET_KEY=your-secure-random-secret-key-here-min-32-chars

# Database - Use PostgreSQL in production
DATABASE_URL=postgresql://username:password@postgres.azurewebsites.net:5432/ai_film_studio
POSTGRES_USER=filmstudio
POSTGRES_PASSWORD=your-secure-password

# Redis Cache & Celery Broker
REDIS_URL=redis://:password@redis.azurewebsites.net:6379/0

# LLM Backend Configuration
LLM_BACKEND=google  # Options: google, claude, openai, ollama
ORCHESTRATOR_BACKEND=langgraph  # Options: langgraph, autogen

# Google Generative AI
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-2.0-flash

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI (Optional)
OPENAI_API_KEY=sk-your-openai-key

# Voice Generation
VOICE_BACKEND=elevenlabs  # Options: elevenlabs, local
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_MODEL=eleven_multilingual_v2

# Video Generation
STABILITY_API_KEY=your-stability-key
REPLICATE_API_TOKEN=your-replicate-token
RUNWAY_API_KEY=your-runway-key

# CORS - Set to your production domain
CORS_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com"]

# File Upload
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=.mp4,.mov,.avi,.mkv,.png,.jpg,.jpeg,.gif,.webp,.svg,.mp3,.wav,.ogg,.flac

# Celery Task Queue
CELERY_BROKER_URL=redis://:password@redis.azurewebsites.net:6379/0
CELERY_RESULT_BACKEND=redis://:password@redis.azurewebsites.net:6379/0

# Email Configuration (SendGrid or Azure Email Service)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=sg_your-sendgrid-api-key
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_TLS=true
EMAIL_VERIFICATION_REQUIRED=true

# Error Monitoring - Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Stripe Payment Processing (if monetized)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Azure Storage for Media/CDN
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=media
CDN_BASE_URL=https://yourdomain.azureedge.net

# Frontend URL
FRONTEND_URL=https://yourdomain.com

# Optional: MongoDB for additional data storage
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/ai_film_studio
