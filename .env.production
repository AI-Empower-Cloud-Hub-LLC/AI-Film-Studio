# ===========================================
# AI Film Studio — Production Environment
# ===========================================
# Fill in all values marked with YOUR_* placeholders

# Application Settings
APP_NAME=AI-Film-Studio
APP_ENV=production
DEBUG=False
API_VERSION=v1
SECRET_KEY=YOUR_SECRET_KEY_HERE_MIN_32_CHARS

# Database - PostgreSQL (Required)
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/ai_film_studio
POSTGRES_USER=filmstudio
POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD

# Redis Cache & Celery Broker (Required)
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@REDIS_HOST:6379/0

# LLM Backend Configuration
LLM_BACKEND=openai
ORCHESTRATOR_BACKEND=langgraph

# OpenAI GPT-4 Configuration
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4-turbo

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY
CLAUDE_MODEL=claude-sonnet-4-20250514

# Google Generative AI (Optional)
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_MODEL=gemini-2.0-flash

# Voice Generation
VOICE_BACKEND=elevenlabs
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_KEY
ELEVENLABS_MODEL=eleven_multilingual_v2

# Video Generation
STABILITY_API_KEY=YOUR_STABILITY_KEY
REPLICATE_API_TOKEN=YOUR_REPLICATE_TOKEN
RUNWAY_API_KEY=YOUR_RUNWAY_KEY

# CORS - Set to your production domain(s)
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# File Upload
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=.mp4,.mov,.avi,.mkv,.png,.jpg,.jpeg,.gif,.webp,.svg,.mp3,.wav,.ogg,.flac

# Celery Task Queue
CELERY_BROKER_URL=redis://:YOUR_REDIS_PASSWORD@REDIS_HOST:6379/0
CELERY_RESULT_BACKEND=redis://:YOUR_REDIS_PASSWORD@REDIS_HOST:6379/0

# Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=sg_YOUR_SENDGRID_API_KEY
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_TLS=true
EMAIL_VERIFICATION_REQUIRED=true

# Error Monitoring - Sentry
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/project-id

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Azure Storage for Media/CDN
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=media
CDN_BASE_URL=https://yourdomain.azureedge.net

# Frontend URL
FRONTEND_URL=https://yourdomain.com
